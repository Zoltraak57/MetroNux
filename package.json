{
  "name": "metronux",
  "productName": "Metronux",
  "version": "1.0.0",
  "description": "Metronux: pemutar musik streaming untuk Linux dengan tema Material You dan Glassmorphism",
  "main": "electron/main.js",
  "desktopName": "metronux.desktop",
  "author": "Metronux",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "vite build",
    "start": "electron .",
    "app": "npm run build && electron .",
    "dist": "npm run build && electron-builder --linux AppImage",
    "test:backend": "node scripts/test-backend.js"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@material/material-color-utilities": "^0.3.0",
    "lucide-react": "^0.468.0",
    "music-metadata": "^12.3.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "youtubei.js": "^18.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.0.0",
    "vite": "^8.3.6"
  },
  "build": {
    "appId": "id.metronux.player",
    "productName": "Metronux",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo;Audio;Player",
      "icon": "build/icon.png",
      "syncDesktopName": true
    }
  }
}
